rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health / connection probe document
    match /test/{docId} {
      allow get: if true;
    }

    // Validation for User document
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt']) &&
             data.uid == userId &&
             data.uid == request.auth.uid &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    // Validation for Project document
    function isValidProject(data) {
      return data.keys().hasAll(['ownerId', 'title', 'slides', 'themeId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'title', 'slides', 'themeId', 'createdAt', 'updatedAt', 'slideCount']) &&
             data.ownerId == request.auth.uid &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.themeId is string && data.themeId.size() <= 100 &&
             data.slides is list && data.slides.size() >= 1 && data.slides.size() <= 100 &&
             (!('slideCount' in data) || (data.slideCount is number && data.slideCount >= 1 && data.slideCount <= 100));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create, update: if isVerified() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming(), userId);
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      match /projects/{projectId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(projectId);

        allow create: if isVerified() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(projectId) &&
                         isValidProject(incoming()) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isVerified() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(projectId) &&
                         isValidProject(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().ownerId == existing().ownerId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'slides', 'themeId', 'updatedAt', 'slideCount']);
      }
    }
  }
}
