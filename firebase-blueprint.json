{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "A user-saved slide presentation project",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the owner user",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the presentation",
          "minLength": 1,
          "maxLength": 200
        },
        "themeId": {
          "type": "string",
          "description": "Selected theme ID",
          "maxLength": 100
        },
        "slides": {
          "type": "array",
          "description": "Array of slide objects in the presentation"
        },
        "slideCount": {
          "type": "number",
          "description": "Total number of slides in presentation"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["ownerId", "title", "slides", "themeId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user document accessible only by that authenticated user"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User specific presentation projects"
    }
  }
}
